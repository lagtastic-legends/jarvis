# ==============================================================================
# JARVIS AI ENVIRONMENT CONFIGURATION
# Zero-Secret Architecture: Server-only keys must NEVER be prefixed with VITE_
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Server-Side Supabase Credentials (Privileged service role)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server-Side AI Intelligence Model Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Client Safe Public Variables (Exposed to browser via Vite)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
